#!/bin/sh
# lab-hosts-up — fa esistere i due host. Gira UNA VOLTA, al boot, PRIMA che lo
# snapshot venga salvato: cosi' chi apre il lab trova la topologia gia' in piedi
# in mezzo secondo, e non paga niente.
#
# Perche' due network namespace e non due macchine virtuali: una CPU x86 emulata
# in WASM e' cara, due sono il doppio. Qui il kernel e' uno solo, ma le pile di
# rete sono due davvero (CONFIG_NET_NS=y, veth.ko), gli indirizzi sono due, e in
# mezzo c'e' un cavo vero. `ssh` non se ne accorge, ed e' tutto quello che serve.
#
# Quello che NON e' vero, e che il capitolo 1 dice apertamente: stesso kernel,
# stesso disco, stessi processi. E' quello che e' un container.

set -e

PC_IP=10.10.0.1
SRV_IP=10.10.0.2
UTENTE_PC=manzolo
UTENTE_SRV=deploy
STATO=/run/lab

mkdir -p "$STATO" /run/netns /var/empty

# --- il modulo del cavo -------------------------------------------------------
# `ip link add ... type veth` lo caricherebbe da solo, ma se un giorno mancasse
# si vedrebbe un errore oscuro molto piu' avanti: meglio dirlo qui.
modprobe veth 2>/dev/null || { echo "lab-hosts-up: manca il modulo veth"; exit 1; }

# --- il secondo host ----------------------------------------------------------
if ! ip netns list 2>/dev/null | grep -q '^server'; then
    ip netns add server
    ip link add veth-pc type veth peer name veth-srv
    ip link set veth-srv netns server

    ip addr add "$PC_IP/24" dev veth-pc
    ip link set veth-pc up

    ip netns exec server ip link set lo up
    ip netns exec server ip addr add "$SRV_IP/24" dev veth-srv
    ip netns exec server ip link set veth-srv up
fi

# --- i due utenti -------------------------------------------------------------
# Li crea il Dockerfile, a build time: qui resta solo la rete di sicurezza, perche'
# senza di loro non parte niente e un errore muto costerebbe un'ora.
#
# (Il punto meno ovvio di tutta l'architettura, e il motivo per cui gli utenti sono
# due: due namespace di RETE non sono due filesystem. Se il pc e il server fossero
# lo stesso utente, ~/.ssh sarebbe LO STESSO FILE e "copiare la chiave sul server"
# non vorrebbe dire niente.)
for u in "$UTENTE_PC" "$UTENTE_SRV"; do
    id "$u" >/dev/null 2>&1 || { echo "lab-hosts-up: manca l'utente $u"; exit 1; }
done

# --- la chiave di identita' del server ----------------------------------------
# Solo ed25519: su una CPU emulata una RSA costa decine di secondi, e `ssh-keygen -A`
# ne genererebbe una senza chiedere. Le RSA che servono ai capitoli (il NAS del
# 2006) vengono da un pool generato a build time, su CPU vera.
[ -f /etc/ssh/ssh_host_ed25519_key ] || \
    ssh-keygen -t ed25519 -N '' -f /etc/ssh/ssh_host_ed25519_key -q </dev/null

cat > /etc/ssh/sshd_config.lab <<'FINE'
HostKey /etc/ssh/ssh_host_ed25519_key
LogLevel VERBOSE
UseDNS no
PermitRootLogin no
PasswordAuthentication yes
PubkeyAuthentication yes
Subsystem sftp /usr/lib/ssh/sftp-server
FINE

# --- sshd, dentro il namespace del server -------------------------------------
if [ ! -s "$STATO/sshd.pid" ] || ! kill -0 "$(cat "$STATO/sshd.pid")" 2>/dev/null; then
    ip netns exec server /usr/sbin/sshd -f /etc/ssh/sshd_config.lab -o "PidFile=$STATO/sshd.pid"
fi

printf '%s' "$SRV_IP"      > "$STATO/srv_ip"
printf '%s' "$PC_IP"       > "$STATO/pc_ip"
printf '%s' "$UTENTE_SRV"  > "$STATO/srv_user"
printf '%s' "$UTENTE_PC"   > "$STATO/pc_user"

echo "lab-hosts-up: $UTENTE_PC@pc $PC_IP  <-->  $UTENTE_SRV@server $SRV_IP"
