# EDU-SSH · SSH Lab — sistema ospite del browser.
#
# v86 emula x86 a 32 bit: Debian e Ubuntu moderni non sono un'opzione (i386 abbandonato),
# Alpine x86 si'. Alpine nasce con BusyBox e musl, quindi i comandi GNU veri si installano
# esplicitamente (packages.txt) — altrimenti si insegnerebbe un `ls` con meta' delle opzioni.
#
# Pinnata a 3.21.0: e' la versione usata da tools/docker/alpine di copy/v86 ed e' quella
# su cui lo spike ha dato numeri buoni. Alzarla e' possibile ma va rimisurato il 9p.
FROM docker.io/i386/alpine:3.21.0

ENV KERNEL=virt

COPY packages.txt /tmp/packages.txt
RUN apk add --no-cache $(grep -v '^#' /tmp/packages.txt | tr '\n' ' ') && rm /tmp/packages.txt

# Le chiavi che servono a costruire i mondi variabili nascono qui, sulla CPU
# reale della build. Generarle dentro v86 aggiungerebbe decine di secondi di
# attesa muta a esercizi in cui la generazione non e' la lezione.
#
# Nomi e posizione sono un contratto dei seed: le host key sono coppie complete
# in una cartella ciascuna; le chiavi utente sono NN e NN.pub. I commenti rendono
# riconoscibili le righe senza essere usati dai check, che confrontano impronte.
RUN set -eu; \
    mkdir -p /opt/lab/hostkeys /opt/lab/keys/ed25519 /opt/lab/keys/rsa; \
    for n in $(seq 1 8); do \
        i=$(printf '%02d' "$n"); d="/opt/lab/hostkeys/$i"; mkdir -p "$d"; \
        ssh-keygen -q -t ed25519 -N '' -C "server-$i@sshlab" \
            -f "$d/ssh_host_ed25519_key" </dev/null; \
    done; \
    for n in $(seq 1 16); do \
        i=$(printf '%02d' "$n"); \
        ssh-keygen -q -t ed25519 -N '' -C "chiave-$i@sshlab" \
            -f "/opt/lab/keys/ed25519/$i" </dev/null; \
    done; \
    for n in $(seq 1 2); do \
        i=$(printf '%02d' "$n"); \
        ssh-keygen -q -t rsa -b 4096 -N '' -C "rsa-$i@sshlab" \
            -f "/opt/lab/keys/rsa/$i" </dev/null; \
    done

# Console dell'utente su ttyS0. NESSUN getty su ttyS1: e' il canale di verifica,
# e deve restare pulito da messaggi del kernel e da login.
# I due utenti del lab, creati QUI e non a runtime: cosi' stanno nell'immagine,
# hanno uid stabili fra una build e l'altra, e /etc/passwd non cambia sotto i piedi
# degli esercizi.
#
# `passwd -u` non e' un dettaglio: `adduser -D` lascia la password BLOCCATA (`!` in
# /etc/shadow) e OpenSSH tratta un account bloccato come un utente CHE NON ESISTE —
# anche entrando con la chiave, dove la password non c'entra niente. Lato client si
# legge solo `Permission denied (publickey)`, identico a una chiave sbagliata, e la
# causa vera sta solo nel log del server. (Costato una serata il 2026-08-16.)
#
# L'ordine conta: prima si crea l'utente, POI gli si da' una password. `passwd -u`
# da solo non funziona su un account che non ne ha ancora una ("unlocking password
# would make it empty" e la build si ferma); e' `chpasswd` che scrive un hash vero
# e con questo sblocca l'account.
#
# La verifica finale non e' pignoleria: se lo shadow non comincia con `$` la
# password non e' stata scritta, e il guasto si presenterebbe molto piu' avanti
# come un `Permission denied (publickey)` senza spiegazione.
RUN adduser -D -s /bin/bash manzolo && adduser -D -s /bin/bash deploy && \
    echo 'manzolo:lab' | chpasswd && echo 'deploy:lab' | chpasswd && \
    addgroup manzolo wheel && addgroup deploy wheel && \
    echo '%wheel ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/lab && chmod 440 /etc/sudoers.d/lab && \
    for u in manzolo deploy; do \
        getent shadow $u | cut -d: -f2 | grep -q '^\$' || \
            { echo "ATTENZIONE: l'account $u e' rimasto bloccato: per sshd non esisterebbe"; exit 1; }; \
    done

# ttyS0 = il pc (manzolo) · ttyS1 = il canale di verifica · ttyS2 = il server (deploy).
# Su ttyS1 NON c'e' nessun getty: e' il canale di verifica e deve restare pulito da
# messaggi del kernel e da login.
RUN sed -i 's/getty 38400 tty1/agetty --autologin root tty1 linux/' /etc/inittab && \
    echo 'ttyS0::respawn:/sbin/agetty --autologin manzolo -s ttyS0 115200 vt100' >> /etc/inittab && \
    echo 'ttyS1::respawn:/opt/lab/bin/labagentd' >> /etc/inittab && \
    echo 'ttyS2::respawn:/opt/lab/bin/lab-tty-server' >> /etc/inittab && \
    echo '::sysinit:/sbin/ip link set lo up' >> /etc/inittab && \
    echo '::sysinit:/sbin/syslogd -O /var/log/messages' >> /etc/inittab && \
    echo '::sysinit:/opt/lab/bin/lab-hosts-up' >> /etc/inittab && \
    sed -i 's/^root:[^:]*:/root::/' /etc/shadow && \
    { setup-hostname pc || true; } && \
    printf 'pc\n' > /etc/hostname && \
    printf 'hostname="pc"\n' > /etc/conf.d/hostname && \
    { grep -qx pc /etc/hostname || { echo "l'hostname del pc non e' stato scritto"; exit 1; }; }
# ATTENZIONE al file giusto: il servizio OpenRC `hostname` legge
# /etc/conf.d/hostname (la variabile), NON /etc/hostname. Scrivendo solo il secondo
# la macchina si presentava ancora come `localhost` — e il prompt del capitolo 1,
# che promette `manzolo@pc`, diceva un'altra cosa alla prima riga.
# NB: /etc/hosts NON si tocca qui. Durante `docker build` e' un file gestito dal
# motore e riscriverlo fa fallire la build. Al lab non serve: i due host si
# chiamano per indirizzo, ed e' anche piu' onesto — la risoluzione dei nomi e'
# un'altra materia.

# La shell di lavoro e' bash, non la ash di BusyBox: e' quella che si trova al lavoro,
# e senza di lei PROMPT_COMMAND non esiste (serve a riportare a casa la shell quando
# l'esercizio cambia e il mondo precedente viene svuotato).
#
# NB: si usa `usermod`, non una sed sul formato della riga. La sed che c'era qui
# cercava `/bin/ash` mentre Alpine scrive `/bin/sh`: non matchava, falliva in
# silenzio, e il capitolo 16 dichiarava una cosa falsa. L'`|| exit 1` finale fa
# fallire la build invece di lasciarlo succedere di nuovo.
RUN usermod -s /bin/bash root && \
    getent passwd root | grep -q ':/bin/bash$' || { echo "la shell di root non e' bash"; exit 1; }

COPY overlay/ /
RUN chmod +x /opt/lab/bin/*

# L'area di servizio del laboratorio. Chi studia e' `manzolo`, non root, e deve
# poterci depositare le proprie risposte (`lab answer`): senza, il comando falliva
# con "Permission denied" al primo uso.
#
# Ma NON basta aprirla: dentro ci vive anche il seme dell'esercizio, che e' il
# cuore dell'anti-trucco. Percio' root:wheel 1775 — lo sticky bit (1) fa si' che
# ognuno possa cancellare solo i propri file. Manzolo crea e riscrive `answer`
# quanto vuole, e non puo' toccare `seed`, che resta di root.
RUN mkdir -p /opt/lab/state && chown root:wheel /opt/lab/state && chmod 1775 /opt/lab/state

RUN for i in devfs dmesg mdev hwdrivers; do rc-update add $i sysinit; done && \
    for i in hwclock modules sysctl hostname bootmisc; do rc-update add $i boot; done && \
    rc-update add killprocs shutdown

RUN mkinitfs -F "base virtio 9p" $(cat /usr/share/kernel/$KERNEL/kernel.release)
